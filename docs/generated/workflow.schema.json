{
  "$defs": {
    "Limits": {
      "additionalProperties": false,
      "properties": {
        "timeout_seconds": {
          "default": 120,
          "exclusiveMinimum": 0,
          "maximum": 3600,
          "title": "Timeout Seconds",
          "type": "integer"
        }
      },
      "title": "Limits",
      "type": "object"
    },
    "Metadata": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
          "title": "Name",
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "title": "Metadata",
      "type": "object"
    },
    "Step": {
      "additionalProperties": false,
      "properties": {
        "after": {
          "patternProperties": {
            "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$": {
              "items": {
                "enum": [
                  "succeeded",
                  "failed",
                  "skipped"
                ],
                "type": "string"
              },
              "type": "array"
            }
          },
          "title": "After",
          "type": "object"
        },
        "depends_on": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
            "type": "string"
          },
          "maxItems": 64,
          "title": "Depends On",
          "type": "array"
        },
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
          "title": "Id",
          "type": "string"
        },
        "uses": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Uses",
          "type": "string"
        },
        "when": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "When"
        },
        "with": {
          "additionalProperties": true,
          "title": "With",
          "type": "object"
        }
      },
      "required": [
        "id",
        "uses",
        "with"
      ],
      "title": "Step",
      "type": "object"
    },
    "Target": {
      "additionalProperties": false,
      "properties": {
        "device_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
          "title": "Device Id",
          "type": "string"
        }
      },
      "required": [
        "device_id"
      ],
      "title": "Target",
      "type": "object"
    },
    "WorkflowSpec": {
      "additionalProperties": false,
      "properties": {
        "limits": {
          "$ref": "#/$defs/Limits"
        },
        "outputs": {
          "maxProperties": 64,
          "patternProperties": {
            "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$": {
              "additionalProperties": true,
              "type": "object"
            }
          },
          "title": "Outputs",
          "type": "object"
        },
        "request_reason": {
          "anyOf": [
            {
              "maxLength": 512,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Request Reason"
        },
        "steps": {
          "items": {
            "$ref": "#/$defs/Step"
          },
          "maxItems": 64,
          "minItems": 1,
          "title": "Steps",
          "type": "array"
        },
        "target": {
          "$ref": "#/$defs/Target"
        }
      },
      "required": [
        "target",
        "steps"
      ],
      "title": "WorkflowSpec",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "apiVersion": {
      "const": "remote.intent/v1",
      "title": "Apiversion",
      "type": "string"
    },
    "kind": {
      "const": "Workflow",
      "title": "Kind",
      "type": "string"
    },
    "metadata": {
      "$ref": "#/$defs/Metadata"
    },
    "spec": {
      "$ref": "#/$defs/WorkflowSpec"
    }
  },
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "title": "Workflow",
  "type": "object"
}
